# ============================================================
# AI Curriculum Recommendation Engine — .gitignore
# ============================================================

# ----- Environment Variables (NEVER commit secrets) -----
.env
backend/.env
frontend/.env

# ----- Python Virtual Environment -----
venv/
backend/venv/
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg
.Python
.cache/
*.pyc

# ----- SQLite Database -----
*.db
*.sqlite
*.sqlite3
backend/curriculum.db

# ----- Node Modules & Frontend Build -----
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.env
*.local

# ----- Logs -----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ----- Editor / IDE -----
.vscode/
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db

# ----- OS Files -----
.DS_Store
Desktop.ini

# ----- Testing & Coverage -----
.pytest_cache/
.coverage
htmlcov/
coverage/

# ----- Docker -----
.dockerignore

# ----- Misc / Scratch -----
ps.md
*.bak
*.tmp
