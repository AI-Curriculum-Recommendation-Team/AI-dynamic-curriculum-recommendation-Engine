# ============================================================
# AI Curriculum Recommendation Engine — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git.

# ----- Database -----
DATABASE_URL=postgresql://curriculum_user:curriculum_pass@localhost:5432/curriculum_db

# ----- Security -----
SECRET_KEY=your-super-secret-key-change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ----- Google OAuth 2.0 -----
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs: http://localhost:8000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ----- AI API Keys -----
# Get your Gemini API key (free tier): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Optional fallback: https://platform.openai.com/api-keys
OPENAI_API_KEY=optional-openai-api-key

# ----- App Config -----
APP_ENV=development
DEBUG=true
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
FRONTEND_URL=http://localhost:5173

# ----- Admin -----
# First user with this email will automatically be promoted to admin
ADMIN_EMAIL=admin@example.com
